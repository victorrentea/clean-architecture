	{field} +goldMemberRemovalReason : String
	{field} +@Id id : Long
	{field} +legalEntityCode : String
	{field} +name : String
	{field} -validatedBy : String
}


class CustomerContext {
	{field} -validatedBy : String
}


interface CustomerState {
}


class CustomerStateGofExample {
}


class CustomerStateMachine {
}


class CustomerStateMachineExample {
}


enum CustomerStatus {
	{field} +ACTIVE
	{field} +DELETED
	{field} +DRAFT
	{field} +VALIDATED
}


class DeletedState {
}


class DraftState {
}


class Email {
	{field} -body : String
	{field} -cc : List
	{field} -from : String
	{field} -subject : String
	{field} -to : String
}


class EmailBuilder {
	{field} -body : String
	{field} -from : String
	{field} -subject : String
	{field} -to : String
