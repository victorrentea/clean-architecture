class StateMachineToPlantUml {
}


enum Status {
	{field} +ACTIVE
	{field} +DELETED
	{field} +DRAFT
	{field} +VALIDATED
}


class Transition {
	{field} -guard : Predicate
	{field} -label : String
}


class User {
	{field} -firstName : String
	{field} -lastName : String
	{field} -username : String
	{field} -workEmail : Optional
}


class ValidatedState {
	{field} -validatedBy : String
}




ActiveState ..|>  CustomerState
Customer -->  Country :  @ManyToOne\ncountry
Customer -->  ShippingAddress : shippingAddress
Customer -->  Status : status
CustomerStateMachine "1" o-- "0..*"  CustomerStatus : graph
CustomerStateMachineExample *--  CustomerStateMachine : INSTANCE
DeletedState ..|>  CustomerState
DraftState ..|>  CustomerState
Holder -->  CustomerState : state
InsurancePolicy -->  Customer :  @ManyToOne\ncustomer
PolicyNotification -->  InsurancePolicy :  @ManyToOne\npolicy
Transition *--  CustomerStatus : target
ValidatedState ..|>  CustomerState


@enduml